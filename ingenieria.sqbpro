lue="111"/><column index="13" value="121"/><column index="14" value="88"/><column index="15" value="91"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- 1. Borramos la tabla anterior para actualizarla
DROP TABLE IF EXISTS finanzas_inventario;

-- 2. Creamos la tabla con los 8 sectores y sus variables matemáticas
CREATE TABLE finanzas_inventario (
    id_inventario INTEGER PRIMARY KEY AUTOINCREMENT,
    nombre_sector TEXT UNIQUE,
    stock_actual INTEGER DEFAULT 100,
    prioridad INTEGER,          -- 1: Crítico, 2: Medio, 3: Bajo
    costo_reposicion REAL,      -- Lo que cuesta subir 1% el stock
    roi_ganancia REAL,          -- Multiplicador de retorno de inversión
    caida_maxima INTEGER        -- Qué tan rápido se desgasta (para el azar)
);

-- 3. Insertamos los 8 valores que representan tu interfaz
INSERT INTO finanzas_inventario 
(nombre_sector, prioridad, costo_reposicion, roi_ganancia, caida_maxima)
VALUES 
('Stock de Vehículos (Core)', 1, 500.0, 0.20, 5),
('Repuestos y Talleres', 2, 120.0, 0.10, 7),
('Infraestructura TI', 1, 300.0, 0.05, 4),
('Mobiliario y Oficina', 3, 50.0, 0.01, 3),
('Flota Logística', 2, 200.0, 0.08, 6),
('Suministros Aseo y Cafetería', 3, 20.0, 0.00, 8),
('Equipos de Seguridad y EPP', 1, 150.0, 0.00, 2),
('Marketing y Merchandising', 2, 110.0, 0.15, 5);</sql><current_tab id="0"/></tab_sql></sqlb_project>
