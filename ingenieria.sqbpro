/><global_filter/></table><table schema="main" name="logs_actividad" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="87"/><column index="3" value="71"/><column index="4" value="300"/><column index="5" value="63"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="seguridad_activos" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="63"/><column index="3" value="95"/><column index="4" value="39"/><column index="5" value="108"/><column index="6" value="96"/><column index="7" value="72"/><column index="8" value="88"/><column index="9" value="91"/><column index="10" value="108"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- 1. Borrar la tabla para aplicar cambios limpios
DROP TABLE IF EXISTS seguridad_activos;

-- 2. Crear la tabla con el esquema de 15 columnas que diseñaste
CREATE TABLE seguridad_activos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    marca TEXT NOT NULL,
    modelo TEXT NOT NULL,
    año INTEGER NOT NULL,
    carro_hash TEXT NOT NULL,
    usuario_asignado TEXT NOT NULL,
    rol_usuario TEXT DEFAULT 'Operador',
    correo_institucional TEXT,
    password_hash TEXT NOT NULL,
    tarjeta_token TEXT NOT NULL,
    pin_seguridad INTEGER,
    ip_ultimo_acceso TEXT,
    intentos_fallidos INTEGER DEFAULT 0,
    vinculo_status TEXT DEFAULT 'ACTIVO',
    ultima_validacion DATETIME,
    nivel_riesgo_acceso TEXT DEFAULT 'BAJO'
);

-- 3. Insertar datos respetando estrictamente el orden de las columnas
INSERT INTO seguridad_activos 
(marca, modelo, año, carro_hash, usuario_asignado, rol_usuario, correo_institucional, password_hash, tarjeta_token, pin_seguridad, ip_ultimo_acceso, intentos_fallidos, vinculo_status, nivel_riesgo_acceso)
VALUES 
('Porsche', '911 Carrera', 2023, 'SHA256-P911-XJ92', 'Carlos Ruiz', 'Admin', 'cruiz@automail.com', '8d969eef6...', 'TK-992-CR', 1234, '192.168.1.15', 0, 'ACTIVO', 'BAJO'),
('Tesla', 'Model 3', 2024, 'SHA256-TM3-KL01', 'Elena Marín', 'Auditor', 'emarin@automail.com', 'f7c3bc1d8...', 'TK-441-EM', 5566, '192.168.1.22', 0, 'ACTIVO', 'MODERADO'),
('Toyota', 'Yaris', 2024, 'SHA256-TY-Y001', 'Juan Pérez', 'Operador', 'jperez@automail.com', 'ef92b778b...', 'TK-112-JP', 9876, '10.0.0.5', 2, 'EN_REVISION', 'CRÍTICO'),
('BMW', 'X5', 2023, 'SHA256-BX5-QR44', 'Sofía Castro', 'Operador', 'scastro@automail.com', '5e884898d...', 'TK-885-SC', 4321, '182.15.4.1', 0, 'ACTIVO', 'BAJO');</sql><current_tab id="0"/></tab_sql></sqlb_project>
