           <widget class="QTreeWidget" name="treeWidget_flota">
            <property name="styleSheet">
             <string notr="true">QTreeWidget {
    background-color: #1a1b26;        /* Fondo oscuro profundo */
    border: 1px solid #414868;        /* Borde sutil */
    border-radius: 8px;
    color: #a9b1d6;                   /* Texto gris azulado */
    font-size: 13px;
    outline: none;                    /* Quita el borde punteado al hacer clic */
}

QTreeWidget::item {
    padding: 8px;                     /* Espacio entre elementos */
    border-bottom: 1px solid #24283b; /* Línea divisoria suave */
}

QTreeWidget::item:selected {
    background-color: rgba(122, 162, 247, 0.2); /* Fondo azul traslúcido */
    color: #7aa2f7;                             /* Texto azul brillante */
    border-left: 3px solid #7aa2f7;             /* Indicador lateral */
}

QTreeWidget::item:hover {
    background-color: #24283b;
}

/* Estilo para las flechitas de expansión */
QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    image: url(path/to/arrow_right.png); /* Opcional: poner tu icono */
}

QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings  {
    image: url(path/to/arrow_down.png);
}QTreeWidget#treeWidget_flota {
    background-color: #1a1b26;
    border: 1px solid #414868;
    border-radius: 8px;
    outline: none;
}

/* Espaciado de las filas */
QTreeWidget#treeWidget_flota::item {
    padding: 12px;                    /* Más espacio vertical y horizontal */
    height: 40px;                     /* Altura fija para mayor orden */
    border-bottom: 1px solid #24283b; /* Línea divisoria muy sutil */
}

/* Encabezados más claros */
QHeaderView::section {
    background-color: #24283b;
    color: #7aa2f7;
    padding: 10px;
    font-weight: bold;
    border: none;
    border-bottom: 2px solid #7aa2f7;
}

/* Estilo para las carpetas (Categorías) */
QTreeWidget#treeWidget_flota::item:has-children {
    background-color: #24283b;
    font-weight: bold;
    color: #bb9af7;                   /* Púrpura para categorías */
}

/* Hover y Selección */
QTreeWidget#treeWidget_flota::item:hover {
    background-color: #2e3344;
}

QTreeWidget#treeWidget_flota::item:selected {
    background-color: rgba(115, 218, 202, 0.2);
    color: #73daca;
    border-left: 4px solid #73daca;
}</string>
