           <widget class="QTableWidget" name="tableWidget_empleados">
            <property name="styleSheet">
             <string notr="true">/* Estilo general de la tabla */
QTableWidget {
    background-color: #1a1b26;        /* Fondo oscuro Tokyo Night */
    alternate-background-color: #1f2335; /* Color ligeramente distinto para filas pares */
    gridline-color: #414868;          /* Color de las líneas de la cuadrícula */
    border: 1px solid #414868;
    border-radius: 10px;
    color: #a9b1d6;
    font-size: 13px;
    selection-background-color: rgba(122, 162, 247, 0.3); /* Fondo de selección neón */
    selection-color: #ffffff;
}

/* Estilo de los encabezados (Nombres de columnas) */
QHeaderView::section {
    background-color: #24283b;
    color: #73daca;                   /* Verde neón para los títulos */
    padding: 10px;
    border: none;
    border-bottom: 2px solid #7aa2f7; /* Línea azul neón bajo el encabezado */
    font-weight: bold;
    font-size: 12px;
    text-transform: uppercase;
}

/* Estilo de las celdas individuales */
QTableWidget::item {
    padding: 5px;
    border: none;
}

/* Efecto al pasar el mouse sobre una fila */
QTableWidget::item:hover {
    background-color: #292e42;
    color: #bb9af7;                   /* El texto se vuelve púrpura al pasar el mouse */
}

/* Estilo de las barras de desplazamiento (ScrollBars) para que combinen */
QScrollBar:vertical {
    border: none;
    background: #16161e;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #414868;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #7aa2f7;             /* El scroll brilla en azul al tocarlo */
}</string>
