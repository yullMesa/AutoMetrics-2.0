  <property name="styleSheet">
   <string notr="true">/* Barra de menú principal */
QMenuBar {
    background-color: #1a1b26;        /* Fondo oscuro principal */
    color: #a9b1d6;                   /* Texto gris azulado */
    padding: 5px;
    font-size: 13px;
    border-bottom: 1px solid #414868; /* Línea separadora sutil */
}

/* Items individuales de la barra (Archivo, Edición, etc.) */
QMenuBar::item {
    background-color: transparent;
    padding: 8px 15px;
    border-radius: 4px;
    margin: 2px;
}

QMenuBar::item:selected {
    background-color: #24283b;        /* Un tono más claro al pasar el mouse */
    color: #7aa2f7;                   /* Texto azul brillante */
}

/* El menú desplegable (lo que sale al hacer clic) */
QMenu {
    background-color: #16161e;        /* Fondo aún más oscuro para profundidad */
    border: 1px solid #7aa2f7;        /* Borde neón azul */
    color: #a9b1d6;
    padding: 5px;
}

QMenu::item {
    padding: 8px 25px 8px 20px;
    border-radius: 2px;
}

QMenu::item:selected {
    background-color: #7aa2f7;        /* Fondo azul neón al seleccionar */
    color: #1a1b26;                   /* Texto oscuro para contraste */
}

/* Separadores dentro del menú */
QMenu::separator {
    height: 1px;
    background: #414868;
    margin: 5px 10px;
}

/* Iconos de flecha para submenús */
QMenu::right-arrow {
    image: url(path/to/right_arrow.png); /* Asegúrate de tener una flecha blanca o azul */
    padding-right: 5px;
}background-color: rgb(34, 34, 34);
background-color: rgb(49, 49, 49);</string>
