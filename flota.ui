                 <property name="styleSheet">
                  <string notr="true">QToolButton {
    background-color: #24283b;        /* Fondo un poco más claro que el principal */
    color: #73daca;                   /* Texto verde esmeralda (neón) */
    border: 2px solid #414868;
    border-radius: 12px;
    padding: 10px;
    font-weight: bold;
    icon-size: 24px;                  /* Tamaño de los iconos de vehículos */
}

QToolButton:hover {
    background-color: #414868;
    border: 2px solid #7aa2f7;        /* Cambia a azul al pasar el mouse */
    color: #ffffff;
}

QToolButton:pressed {
    background-color: #7aa2f7;
    color: #1a1b26;
}

/* Si usas ToolButtons con texto abajo del icono */
QToolButton[toolButtonStyle=&quot;ToolButtonTextUnderIcon&quot;] {
    padding-top: 15px;
}</string>
