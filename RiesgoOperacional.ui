              <item>
               <widget class="QPlainTextEdit" name="plainTextEdit">
                <property name="styleSheet">
                 <string notr="true">/* Estilo para el cuadro de texto de alertas/riesgo */
QPlainTextEdit {
    background-color: #1a1a26; /* Un tono más oscuro para profundidad */
    color: #ffcc00; /* Amarillo/Naranja Neón (Color de Alerta) */
    font-family: 'Consolas', 'Courier New', monospace; /* Fuente de terminal */
    font-size: 13px;
    border: 1px solid #ffcc00; /* Borde de alerta */
    border-radius: 5px;
    padding: 10px;
    selection-background-color: #ffcc00;
    selection-color: #1a1a26;
}

/* Estilo de la barra de desplazamiento para que combine con la alerta */
QPlainTextEdit QScrollBar:vertical {
    border: none;
    background: #1a1a26;
    width: 8px;
}

QPlainTextEdit QScrollBar::handle:vertical {
    background: #ffcc00;
    border-radius: 4px;
    min-height: 20px;
}

/* Estilo cuando el widget tiene el foco (clic del usuario) */
QPlainTextEdit:focus {
    border: 2px solid #ffcc00;
    background-color: #1e1e2e;
    /* Efecto de resplandor sutil */
    box-shadow: 0 0 10px rgba(255, 204, 0, 0.5);
}
QPlainTextEdit {
    background-color: #1a1a26;
    color: #ffcc00; /* Color Ámbar de Alerta */
    font-family: 'Consolas', monospace;
    font-size: 18px; /* Tamaño mucho más grande */
    font-weight: bold;
    border: 2px solid #ffcc00;
    border-radius: 10px;
    padding: 20px;
    /* Qt no centra texto en PlainText automáticamente, 
       pero el padding ayuda a la visualización */
}</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
           </widget>
