                <property name="styleSheet">
                 <string notr="true">QLabel {
    color: #ffffff;
    font-family: &quot;Segoe UI Semibold&quot;;
    font-size: 14px;
    background: transparent;
    padding: 2px;
}

/* Estilo específico para destacar títulos con un borde inferior neón */
QLabel#label_titulo {
    color: #00ffcc;
    font-size: 18px;
    border-bottom: 2px solid #00ffcc;
    padding-bottom: 5px;
    margin-bottom: 10px;
}</string>
                </property>
                <property name="text">
                 <string>¿El costo acumulado de mantenimiento y seguro supera ya el 5% del valor de venta proyectado?</string>
                </property>
                <property name="alignment">
                 <set>Qt::AlignmentFlag::AlignCenter</set>
                </property>
               </widget>
              </item>
              <item row="0" column="1">
               <widget class="QComboBox" name="comboBox_Costo">
                <property name="styleSheet">
                 <string notr="true">/* Estilo del ComboBox (Cerrado) */
QComboBox {
    background-color: #27293d;
    border: 1px solid #3c3c4c;
    border-radius: 5px;
    padding: 5px 10px;
    color: #ffffff;
    font-family: &quot;Segoe UI&quot;, sans-serif;
    min-width: 150px;
}

/* Cuando pasas el mouse o está enfocado */
QComboBox:hover, QComboBox:focus {
    border: 1px solid #00ffcc; /* Borde neón */
}

/* Estilo del botón de la flechita */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left: 1px solid #3c3c4c;
}

/* La flechita (puedes usar un carácter o una imagen) */
QComboBox::down-arrow {
    image: url(down_arrow_cyan.png); /* Si tienes icono */
    width: 12px;
    height: 12px;
}

/* --- ESTILO DE LA LISTA DESPLEGABLE --- */
QComboBox QAbstractItemView {
    background-color: #1e1e2e;
    color: #ffffff;
    border: 1px solid #00ffcc;
    selection-background-color: #00ffcc;
    selection-color: #1e1e2e;
    outline: none;
    border-radius: 5px;
}

/* Cada item de la lista */
QComboBox QAbstractItemView::item {
    min-height: 30px;
    padding-left: 10px;
}

/* Item seleccionado en la lista */
QComboBox QAbstractItemView::item:selected {
    background-color: #00ffcc;
    color: #1e1e2e;
}</string>
