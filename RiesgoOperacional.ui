              <item>
               <widget class="QSlider" name="horizontalSlider_2">
                <property name="styleSheet">
                 <string notr="true">/* Estilo específico para horizontalSlider_2 */
QSlider#horizontalSlider_2::groove:horizontal {
    border: 1px solid #3c3c4c;
    height: 8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
                                stop:0 #00ffcc, 
                                stop:1 #ff4d4d); /* Gradiente de Verde a Rojo */
    margin: 2px 0;
    border-radius: 4px;
}

QSlider#horizontalSlider_2::handle:horizontal {
    background: #ffffff;
    border: 2px solid #00ffcc;
    width: 20px;
    height: 20px;
    margin: -7px 0;
    border-radius: 10px;
}

/* Efecto cuando el usuario presiona el manejador */
QSlider#horizontalSlider_2::handle:horizontal:pressed {
    background: #00ffcc;
    border: 2px solid #ffffff;
}

/* La parte de la barra que queda a la izquierda (ya recorrida) */
QSlider#horizontalSlider_2::sub-page:horizontal {
    background: rgba(0, 255, 204, 0.3); /* Un rastro brillante sutil */
    border-radius: 4px;
}</string>
