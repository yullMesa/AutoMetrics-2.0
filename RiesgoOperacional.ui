              <item row="0" column="1">
               <widget class="QComboBox" name="comboBox_empleado">
                <property name="styleSheet">
                 <string notr="true">/* Estilo principal del ComboBox */
QComboBox {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 5px 10px;
    color: #cdd6f4;
    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-size: 13px;
    min-width: 150px;
}

/* Cuando el ComboBox está enfocado o el mouse encima */
QComboBox:hover, QComboBox:focus {
    border: 1px solid #89b4fa;
    background-color: #3b3d54;
}

/* Estilo de la flechita (Drop-down button) */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border-left: 1px solid #45475a;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* La imagen de la flecha */
QComboBox::down-arrow {
    image: url(down_arrow_icon.png); /* Si tienes un icono, si no usa el default */
    width: 12px;
    height: 12px;
}

/* Estilo de la lista desplegable (El menú que baja) */
QComboBox QAbstractItemView {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #45475a;
    selection-background-color: #89b4fa;
    selection-color: #11111b;
    outline: none;
    padding: 5px;
}

/* Estilo de cada elemento dentro de la lista */
QComboBox QAbstractItemView::item {
    height: 30px;
    padding-left: 10px;
}</string>
                </property>
               </widget>
              </item>
