  <property name="styleSheet">
   <string notr="true">/* Estilo general de la barra de menú */
QMenuBar {
    background-color: #1e1e2e;
    color: #ffffff;
    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-size: 13px;
    border-bottom: 1px solid #3c3c4c;
    padding: 2px;
}

/* Estilo de los items del menú (Archivo, Edición, etc.) */
QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
    margin: 2px;
    border-radius: 4px;
}

/* Cuando pasas el mouse por encima de los items de la barra principal */
QMenuBar::item:selected {
    background-color: rgba(0, 255, 204, 0.1); /* Fondo cian muy suave */
    color: #00ffcc; /* Texto cian neón */
}

/* Estilo de los menús desplegables */
QMenu {
    background-color: #1e1e2e;
    color: #ffffff;
    border: 1px solid #00ffcc; /* Borde neón para destacar el menú */
    border-radius: 5px;
    padding: 5px;
}

/* Estilo de las opciones dentro del menú desplegable */
QMenu::item {
    padding: 8px 25px 8px 20px;
    border-radius: 3px;
    margin: 2px;
}

/* Cuando seleccionas una opción dentro del menú */
QMenu::item:selected {
    background-color: #00ffcc; /* Fondo cian neón */
    color: #1e1e2e; /* Texto oscuro para contraste */
}

/* Separadores dentro del menú */
QMenu::separator {
    height: 1px;
    background: #3c3c4c;
    margin: 5px 10px;
}

/* Estilo para las flechas de submenús */
QMenu::right-arrow {
    image: url(flecha_derecha.png); /* Si tienes iconos, sino, se ve estándar */
    padding-right: 5px;
}
</string>
