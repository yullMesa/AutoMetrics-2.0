           <widget class="QFrame" name="frame_11">
            <property name="styleSheet">
             <string notr="true">/* Estilo para el contenedor principal de la pestaña */
QFrame{
    background-color: #0d1117; /* Azul casi negro estilo terminal */
    border: 2px solid #00ffcc; /* Borde cian neón */
    border-radius: 15px;
    
    /* Efecto de degradado sutil para dar profundidad */
    background-image: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, 
        stop:0 rgba(13, 17, 23, 255), 
        stop:1 rgba(22, 27, 34, 255));
}

/* Decoración para los títulos dentro de este frame */
QLabel {
    color: #00ffcc;
    font-family: &quot;Consolas&quot;, &quot;Courier New&quot;;
    font-weight: bold;
    text-shadow: 0 0 10px #00ffcc; /* Brillo neón (solo si el sistema lo soporta) */
}

/* Estilo para los campos de entrada dentro del frame (Hashes/Tokens) */
QLineEdit {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-bottom: 2px solid #00ffcc; /* Línea de acento neón */
    color: #00ffcc;
    padding: 5px;
    font-family: &quot;Consolas&quot;;
}

/* Efecto cuando pasas el mouse por encima de los botones */
QPushButton:hover {
    background-color: #00ffcc;
    color: #0d1117;
    border: 1px solid #ffffff;
}</string>
            </property>
