          <item row="1" column="0">
           <widget class="QTableWidget" name="tableWidget_clientes">
            <property name="styleSheet">
             <string notr="true">/* Estilo General de la Tabla */
QTableWidget {
    background-color: #1e1e2e;
    alternate-background-color: #181825;
    color: #cdd6f4;
    gridline-color: #313244;
    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-size: 13px;
    border: 1px solid #45475a;
    border-radius: 8px;
    selection-background-color: #b4befe;
    selection-color: #11111b;
}

/* Estilo de las Cabeceras (Headers) */
QHeaderView::section {
    background-color: #313244;
    color: #89b4fa;
    padding: 6px;
    border: 1px solid #181825;
    font-weight: bold;
    font-size: 14px;
}

/* Estilo de las Filas al pasar el mouse (Hover) */
QTableWidget::item:hover {
    background-color: #45475a;
    color: #f5e0dc;
}

/* Estilo de la Fila Seleccionada */
QTableWidget::item:selected {
    background-color: #89b4fa;
    color: #11111b;
    font-weight: bold;
}

/* Personalización de la Barra de Desplazamiento (Scrollbar) */
QScrollBar:vertical {
    border: none;
    background: #181825;
    width: 10px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background: #585b70;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}</string>
            </property>
