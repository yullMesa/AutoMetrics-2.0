              <item>
               <widget class="QPushButton" name="btn_evaluar">
                <property name="styleSheet">
                 <string notr="true">/* Estilo base del botón */
QPushButton {
    background-color: rgba(0, 255, 204, 0.05); /* Fondo muy sutil */
    color: #00ffcc;
    border: 2px solid #00ffcc;
    border-radius: 10px;
    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-size: 14px;
    font-weight: bold;
    padding: 8px 16px;
    min-width: 120px;
}

/* Efecto Hover: Cuando el mouse está encima */
QPushButton:hover {
    background-color: #00ffcc;
    color: #1e1e2e; /* El texto se oscurece para contrastar */
    /* Efecto de resplandor (solo funciona bien en algunos sistemas, 
       pero el cambio de color sólido es suficiente) */
}

/* Efecto Pressed: Cuando se hace clic */
QPushButton:pressed {
    background-color: #00ccaa; /* Un cian más oscuro */
    border-color: #ffffff;
    padding-left: 10px; /* Efecto de hundimiento */
    padding-top: 10px;
}

/* Estilo para un botón de &quot;PELIGRO&quot; o &quot;ELIMINAR&quot; (opcional) */
QPushButton#btn_peligro {
    color: #ff4d4d;
    border: 2px solid #ff4d4d;
    background-color: rgba(255, 77, 77, 0.05);
}

QPushButton#btn_peligro:hover {
    background-color: #ff4d4d;
    color: #ffffff;
}</string>
                </property>
