               <widget class="QLabel" name="label_15">
                <property name="styleSheet">
                 <string notr="true">/* Estilo base para todos los Labels */
QLabel {
    color: #cdd6f4; /* Texto claro (Catppuccin Text) */
    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-size: 13px;
    background: transparent;
}

/* Estilo para Títulos (ej: &quot;Gestión de Cumplimiento&quot;) */
QLabel#label_titulo {
    color: #89b4fa; /* Azul */
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 5px;
}

/* Estilo para etiquetas de información importante (como el Nombre del Cliente) */
QLabel#label_info {
    background-color: #313244;
    color: #a6e3a1; /* Verde para destacar información positiva */
    padding: 4px 8px;
    border-radius: 4px;
    font-weight: bold;
}

/* Estilo para labels de alerta o riesgo */
QLabel#label_alerta {
    color: #f38ba8; /* Rojo */
    font-weight: bold;
    text-transform: uppercase;
}</string>
                </property>
