              <item>
               <widget class="QTableWidget" name="tableWidget_persona">
                <property name="styleSheet">
                 <string notr="true">/* Estilo General de la Tabla */
QTableWidget {
    background-color: rgba(13, 17, 23, 180); /* Fondo oscuro semitransparente */
    border: 1px solid #00ffcc;               /* Borde cian neón */
    gridline-color: #1a232e;                 /* Color de las líneas internas muy sutil */
    color: #ffffff;                          /* Texto principal blanco */
    font-family: &quot;Consolas&quot;, &quot;Monospace&quot;;
    font-size: 12px;
    selection-background-color: rgba(0, 255, 204, 50); /* Resaltado al hacer clic */
    selection-color: #00ffcc;
}

/* Estilo de los Encabezados (Marca, Modelo, Hash, etc.) */
QHeaderView::section {
    background-color: #0d1117;
    color: #00ffcc;                          /* Texto del encabezado neón */
    padding: 6px;
    border: 1px solid #1a232e;
    font-weight: bold;
    text-transform: uppercase;               /* Todo en mayúsculas para estilo pro */
}

/* Estilo de las Filas al pasar el mouse */
QTableWidget::item:hover {
    background-color: rgba(0, 255, 204, 20);
    color: #00ffcc;
}

/* Quitar el borde de enfoque (el cuadro de puntos al hacer clic) */
QTableWidget:focus {
    outline: none;
    border: 1px solid #ffffff; /* El borde brilla más al estar activa */
}

/* Personalización de la Barra de Desplazamiento (Scrollbar) */
QScrollBar:vertical {
    border: none;
    background: #0d1117;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #00ffcc;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}</string>
