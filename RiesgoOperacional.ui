              <item>
               <widget class="QPlainTextEdit" name="plainTextEdit_2">
                <property name="styleSheet">
                 <string notr="true">QPlainTextEdit {
    /* Fondo negro profundo estilo OLED */
    background-color: #050505; 
    
    /* Letra verde neón clásica de terminal */
    color: #00ff41; 
    
    /* Fuente tipo hacker: Consolas es la estándar, 
       pero agregamos alternativas por si no está instalada */
    font-family: &quot;Consolas&quot;, &quot;Monospace&quot;, &quot;Courier New&quot;, &quot;OCR A Extended&quot;;
    font-size: 13px;
    
    /* Borde neón con bordes redondeados */
    border: 1px solid #00ff41;
    border-radius: 8px;
    
    /* Espaciado interno para que el texto no pegue al borde */
    padding: 10px;
}

/* Estilo para la barra de desplazamiento (Scrollbar) para que combine */
QScrollBar:vertical {
    border: none;
    background: #050505;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #00ff41;
    min-height: 20px;
    border-radius: 4px;
}

/* Efecto cuando el mouse entra al cuadro (opcional) */
QPlainTextEdit:hover {
    border: 1px solid #ffffff;
    background-color: #0a0a0a;
}</string>
                </property>
               </widget>
