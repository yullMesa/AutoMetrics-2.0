               <widget class="QTableWidget" name="tableWidget_riesgo">
                <property name="styleSheet">
                 <string notr="true">/* Estilo general de la tabla */
QTableWidget {
    background-color: #1e1e2e;
    color: #ffffff;
    gridline-color: #2d2d3d; /* Color de las líneas de la cuadrícula */
    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-size: 13px;
    border: 1px solid #3c3c4c;
    border-radius: 8px;
    selection-background-color: rgba(0, 255, 204, 0.2);
    selection-color: #00ffcc;
}

/* Estilo de las cabeceras (Columnas superiores) */
QHeaderView::section {
    background-color: #27293d;
    color: #00ffcc;
    padding: 10px;
    border: none;
    border-bottom: 2px solid #00ffcc; /* Línea neón bajo el título */
    font-weight: bold;
    text-transform: uppercase;
    font-size: 11px;
}

/* Estilo de las filas */
QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #2d2d3d;
}

/* Hover: Cuando el mouse pasa sobre una celda */
QTableWidget::item:hover {
    background-color: rgba(0, 255, 204, 0.05);
}

/* Cuando una celda o fila está seleccionada */
QTableWidget::item:selected {
    background-color: rgba(0, 255, 204, 0.15);
    color: #00ffcc;
    font-weight: bold;
}

/* Estilo del &quot;Corner Button&quot; (el cuadrito arriba a la izquierda) */
QTableWidget QTableCornerButton::section {
    background-color: #27293d;
    border: none;
}

/* ScrollBar Vertical (Barra de desplazamiento) */
QScrollBar:vertical {
    border: none;
    background: #1e1e2e;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #3c3c4c;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #00ffcc; /* Brilla al interactuar */
}</string>
