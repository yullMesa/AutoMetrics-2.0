              <item>
               <widget class="QPushButton" name="push_conversa">
                <property name="sizePolicy">
                 <sizepolicy hsizetype="Minimum" vsizetype="Expanding">
                  <horstretch>0</horstretch>
                  <verstretch>0</verstretch>
                 </sizepolicy>
                </property>
                <property name="styleSheet">
                 <string notr="true">/* Estilo base del botón */
QPushButton {
    background-color: #89b4fa; /* Color azul pastel (Catppuccin Blue) */
    color: #11111b;            /* Texto oscuro para contraste */
    border-radius: 8px;
    padding: 8px 16px;
    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-weight: bold;
    font-size: 13px;
    border: none;
}

/* Efecto al pasar el mouse (Hover) */
QPushButton:hover {
    background-color: #b4befe; /* Color un poco más claro */
    border: 1px solid #cdd6f4;
}

/* Efecto al presionar (Pressed) */
QPushButton:pressed {
    background-color: #74c7ec; /* Color más intenso */
    padding-left: 18px;        /* Pequeño desplazamiento para simular click */
    padding-top: 10px;
}

/* Estado Deshabilitado (cuando no hay cliente seleccionado) */
QPushButton:disabled {
    background-color: #45475a;
    color: #7f849c;
}

/* Estilo específico para botones de &quot;Cerrar&quot; o &quot;Reiniciar&quot; (Opcional) */
QPushButton#btn_reiniciar {
    background-color: #f38ba8; /* Color rojizo */
}

QPushButton#btn_reiniciar:hover {
    background-color: #eba0ac;
}</string>
                </property>
                <property name="text">
                 <string>Generar Conversación</string>
                </property>
               </widget>
