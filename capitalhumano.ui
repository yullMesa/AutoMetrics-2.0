         <layout class="QGridLayout" name="gridLayout_3">
          <item row="0" column="0">
           <widget class="QTreeWidget" name="treeWidget_clasificacion">
            <property name="styleSheet">
             <string notr="true">QTreeWidget {
    background-color: #1a1b26;        /* Fondo oscuro principal */
    alternate-background-color: #24283b;
    color: #c0caf5;                   /* Texto blanco azulado */
    border: 1px solid #414868;
    border-radius: 8px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
    outline: none;
    padding: 5px;
}

/* Estilo para los ítems (filas) */
QTreeWidget::item {
    padding: 6px;
    border-bottom: 1px solid #24283b;
}

/* Cuando pasas el mouse por encima de una rama o empleado */
QTreeWidget::item:hover {
    background-color: rgba(122, 162, 247, 0.1);
    color: #7aa2f7;
}

/* Cuando seleccionas un elemento */
QTreeWidget::item:selected {
    background-color: #7aa2f7;
    color: #1a1b26;
    font-weight: bold;
    border-radius: 4px;
}

/* Estilo de la flechita (indicador de expansión) */
QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    image: url(none); /* Aquí podrías poner un icono de flecha propia */
    border-image: none;
}

/* Encabezado del TreeWidget (si lo usas) */
QHeaderView::section {
    background-color: #16161e;
    color: #bb9af7;                   /* Color purpura para distinguir de la tabla */
    padding: 8px;
    border: none;
    font-weight: bold;
    text-transform: uppercase;
    border-bottom: 2px solid #bb9af7;
}

/* Personalización de la barra de scroll */
QScrollBar:vertical {
    border: none;
    background: #1a1b26;
    width: 8px;
}

QScrollBar::handle:vertical {
    background: #414868;
    border-radius: 4px;
}</string>
