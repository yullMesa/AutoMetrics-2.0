              <item>
               <widget class="QPushButton" name="pushButton_anadir">
                <property name="styleSheet">
                 <string notr="true">QPushButton {
    background-color: #7aa2f7;        /* Azul neón */
    color: #1a1b26;                   /* Texto oscuro para contraste */
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
    font-weight: bold;
    border-radius: 6px;
    padding: 8px 16px;
    border: none;
}

/* Cuando el mouse pasa por encima */
QPushButton:hover {
    background-color: #89b4fa;        /* Azul un poco más claro */
}

/* Cuando se mantiene presionado */
QPushButton:pressed {
    background-color: #565f89;        /* Se oscurece para dar efecto de hundido */
    color: #ffffff;
}

/* Si el botón está desactivado */
QPushButton:disabled {
    background-color: #24283b;
    color: #414868;
}</string>
                </property>
                <property name="text">
                 <string>AÑADIR</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QPushButton" name="btn_eliminar">
                <property name="styleSheet">
                 <string notr="true">QPushButton {
    background-color: rgba(247, 118, 142, 0.1); /* Fondo rojizo transparente */
    color: #f7768e;                            /* Texto rojo neón */
    border: 2px solid #f7768e;                 /* Borde sólido */
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
    font-weight: bold;
    border-radius: 6px;
    padding: 8px 16px;
}

/* Cuando el mouse pasa por encima */
QPushButton#btn_eliminar:hover {
    background-color: #f7768e;                 /* Se llena de color rojo */
    color: #1a1b26;                            /* Texto cambia a oscuro */
}

/* Cuando se mantiene presionado */
QPushButton#btn_eliminar:pressed {
    background-color: #db4b4b;                 /* Rojo más intenso */
    border: 2px solid #db4b4b;
}</string>
                </property>
                <property name="text">
                 <string>ELIMINAR</string>
