              <item row="0" column="1">
               <widget class="QLineEdit" name="txt_empleado">
                <property name="styleSheet">
                 <string notr="true">QLineEdit {
    background-color: #1a1b26;        /* Fondo oscuro igual al dashboard */
    color: #c0caf5;                   /* Texto blanco azulado */
    border: 2px solid #414868;        /* Borde gris azulado discreto */
    border-radius: 6px;               /* Bordes suavemente redondeados */
    padding: 8px 12px;                /* Espaciado interno para el texto */
    font-size: 13px;
    font-family: 'Segoe UI', sans-serif;
    selection-background-color: #7aa2f7; /* Color al resaltar texto */
}

/* Efecto cuando el usuario hace clic para escribir (Focus) */
QLineEdit:focus {
    border: 2px solid #7aa2f7;        /* Borde brilla en azul neón */
    background-color: #24283b;        /* Se aclara sutilmente el fondo */
    color: #ffffff;                   /* El texto resalta más */
}

/* Estilo para el texto de ayuda (Placeholder) */
QLineEdit::placeholder {
    color: #565f89;                   /* Gris oscuro para que no distraiga */
    font-style: italic;
}

/* Estilo si el campo está desactivado (Read Only) */
QLineEdit:read-only {
    background-color: #16161e;
    color: #414868;
    border: 1px dashed #24283b;
}</string>
                </property>
               </widget>
