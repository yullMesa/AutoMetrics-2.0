  <property name="styleSheet">
   <string notr="true">/* El fondo de la barra de menú superior */
QMenuBar {
    background-color: #1a1b26; /* Fondo oscuro Tokyo Night */
    color: #a9b1d6;            /* Texto gris azulado suave */
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
    padding: 4px;
    border-bottom: 1px solid #414868; /* Línea sutil divisoria */
}

/* Estilo cuando pasas el mouse por encima de los menús (Capital Humano, etc.) */
QMenuBar::item:selected {
    background-color: #24283b;
    color: #7aa2f7;           /* Azul neón al seleccionar */
    border-radius: 4px;
}

/* Estilo de los menús desplegables */
QMenu {
    background-color: #1a1b26;
    color: #a9b1d6;
    border: 1px solid #414868;
    border-radius: 5px;
    padding: 5px;
}

/* Estilo de las acciones dentro del menú (las opciones internas) */
QMenu::item {
    padding: 6px 25px 6px 20px;
    border-radius: 3px;
}

/* Cuando pasas el mouse sobre una opción específica (ej: Directorio) */
QMenu::item:selected {
    background-color: #7aa2f7; /* Fondo azul brillante */
    color: #1a1b26;            /* Texto oscuro para contraste */
}

/* Estilo de los separadores entre opciones */
QMenu::separator {
    height: 1px;
    background: #414868;
    margin: 5px 10px;
}</string>
  </property>
