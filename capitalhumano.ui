               <widget class="QTableWidget" name="tableWidget_EMPLEADOS">
                <property name="styleSheet">
                 <string notr="true">/* Estilo general de la tabla */
QTableWidget {
    background-color: #1a1b26;        /* Fondo oscuro */
    alternate-background-color: #24283b; /* Color para filas alternas (cebreado) */
    color: #c0caf5;                   /* Color de texto */
    gridline-color: #414868;          /* Color de las líneas de la cuadrícula */
    border: 1px solid #414868;
    border-radius: 8px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 12px;
    outline: none;                    /* Quita el borde de enfoque al hacer clic */
}

/* Estilo de la fila seleccionada */
QTableWidget::item:selected {
    background-color: #7aa2f7;        /* Azul neón al seleccionar */
    color: #1a1b26;                   /* Texto oscuro para contraste */
    font-weight: bold;
}

/* Encabezados (Cabecera de la tabla) */
QHeaderView::section {
    background-color: #16161e;        /* Un tono más oscuro que el fondo */
    color: #7aa2f7;                   /* Títulos en azul neón */
    padding: 6px;
    border: none;
    border-bottom: 2px solid #7aa2f7; /* Línea neón bajo el título */
    font-weight: bold;
    text-transform: uppercase;
}

/* Estilo de las barras de desplazamiento (Scrollbars) */
QScrollBar:vertical {
    border: none;
    background: #1a1b26;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #414868;              /* Color de la barra que se mueve */
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #7aa2f7;              /* Brilla al pasar el mouse */
}</string>
                </property>
