              <item>
               <widget class="QPushButton" name="pushButton_evaluar">
                <property name="sizePolicy">
                 <sizepolicy hsizetype="Minimum" vsizetype="Expanding">
                  <horstretch>0</horstretch>
                  <verstretch>0</verstretch>
                 </sizepolicy>
                </property>
                <property name="styleSheet">
                 <string notr="true">/* Estilo general del botón */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #24283b, stop:1 #1a1b26);
    color: #7aa2f7; /* Azul neón */
    border: 1px solid #414868;
    border-radius: 5px;
    padding: 8px 15px;
    font-size: 13px;
    font-weight: bold;
    min-width: 100px;
}

/* Cuando pasas el mouse (Hover) */
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #2f334d, stop:1 #24283b);
    border: 1px solid #7aa2f7;
    color: #ffffff; /* El texto brilla en blanco */
}

/* Cuando haces clic (Pressed) */
QPushButton:pressed {
    background-color: #7aa2f7;
    color: #1a1b26; /* Inversión de colores para feedback táctil */
    border: 1px solid #bb9af7;
    padding-top: 10px; /* Efecto de hundimiento */
    padding-left: 17px;
}

/* Botón especial para &quot;Calcular&quot; o &quot;Vender&quot; (Acento Verde) */
QPushButton#btn_principal {
    color: #9ece6a;
    border: 1px solid #9ece6a;
}

QPushButton#btn_principal:hover {
    background-color: #9ece6a;
    color: #1a1b26;
}

/* Botón de Peligro o Reset (Acento Rojo) */
QPushButton#btn_peligro {
    color: #f7768e;
    border: 1px solid #f7768e;
}

QPushButton#btn_peligro:hover {
    background-color: #f7768e;
    color: #1a1b26;
}</string>
                </property>
                <property name="text">
                 <string>Evaluar</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
           </widget>
          </item>
         </layout>
        </widget>
