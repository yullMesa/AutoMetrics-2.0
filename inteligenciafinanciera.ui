                <property name="styleSheet">
                 <string notr="true">color: rgb(255, 255, 255);
/* Estilo base para todos los Labels */
QLabel {
    color: #a9b1d6;
    font-family: &quot;Segoe UI&quot;, sans-serif;
    background: transparent;
}

/* Label para Títulos de sección */
QLabel#titulo_seccion {
    color: #bb9af7; /* Morado neón */
    font-size: 14px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Label para mostrar el valor actual de los Sliders */
QLabel#valor_slider {
    color: #7aa2f7; /* Azul brillante */
    font-family: &quot;Consolas&quot;, monospace;
    font-size: 16px;
    font-weight: bold;
    background-color: #24283b;
    border-radius: 4px;
    padding: 2px 10px;
    border: 1px solid #414868;
}

/* Label para advertencias o estados (ej: &quot;VENDER&quot;) */
QLabel#status_alerta {
    color: #f7768e; /* Rojo neón */
    font-size: 18px;
    font-weight: bold;
    border: 2px solid #f7768e;
    border-radius: 5px;
    padding: 10px;
}</string>
                </property>
