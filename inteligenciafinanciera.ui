           <widget class="QTableWidget" name="tableWidget_ranking">
            <property name="styleSheet">
             <string notr="true">/* Contenedor principal de la tabla */
QTableWidget {
    background-color: #1a1b26;
    alternate-background-color: #24283b; /* Efecto cebra para lectura rápida */
    color: #a9b1d6;
    gridline-color: #414868;
    border: 1px solid #414868;
    border-radius: 8px;
    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-size: 13px;
    outline: none;
}

/* Encabezados de las columnas */
QHeaderView::section {
    background-color: #16161e;
    color: #7aa2f7; /* Azul neón para los títulos */
    padding: 10px;
    border: none;
    border-bottom: 2px solid #7aa2f7;
    font-weight: bold;
    text-transform: uppercase;
}

/* Estilo de las celdas individuales */
QTableWidget::item {
    padding: 5px;
    border: none;
}

/* Color cuando seleccionas una fila */
QTableWidget::item:selected {
    background-color: #2f334d;
    color: #9ece6a; /* Verde neón al seleccionar (Éxito/Rentabilidad) */
}

/* Efecto al pasar el mouse sobre las filas */
QTableWidget::item:hover {
    background-color: #292e42;
}

/* Estilo de la barra de desplazamiento (Scrollbar) para que no rompa la estética */
QScrollBar:vertical {
    border: none;
    background: #1a1b26;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #414868;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #7aa2f7;
}</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
