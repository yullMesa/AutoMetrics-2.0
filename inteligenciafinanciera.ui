                 <string notr="true">/* Estilo Base para ambos (Fondo y Bordes) */
color: rgb(255, 30, 82);
QLCDNumber {
    background-color: #16161e; /* Un tono más oscuro que el fondo general */
    border: 2px solid #414868;
    border-radius: 6px;
    padding: 5px;
}

/* Estado VERDE (Ganancia / ROI Positivo) */
QLCDNumber#lcd_verde {
    color: #9ece6a; /* Verde neón */
    border-color: #9ece6a;
}

/* Estado ROJO (Depreciación / Gasto) */
QLCDNumber#lcd_rojo {
    color: #f7768e; /* Rojo/Rosa neón */
    border-color: #f7768e;
}</string>
