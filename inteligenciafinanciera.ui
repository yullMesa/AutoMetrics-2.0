  <property name="styleSheet">
   <string notr="true">/* Estilo general de la barra de menú */
QMenuBar {
    background-color: #1a1b26; /* Fondo oscuro a juego con los frames */
    color: #a9b1d6;            /* Texto gris azulado suave */
    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-size: 13px;
    padding: 4px;
    border-bottom: 1px solid #414868; /* Línea sutil de separación */
}

/* Estilo de los items principales (Archivo, Herramientas, etc.) */
QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
    margin: 2px;
    border-radius: 4px;
}

/* Efecto cuando pasas el mouse por encima o seleccionas */
QMenuBar::item:selected {
    background-color: #24283b;
    color: #7aa2f7; /* Azul brillante */
}

QMenuBar::item:pressed {
    background-color: #414868;
    color: #ffffff;
}

/* Estilo de los menús desplegables */
QMenu {
    background-color: #1a1b26;
    color: #a9b1d6;
    border: 1px solid #414868;
    border-radius: 5px;
    padding: 5px;
}

/* Items dentro del menú desplegable */
QMenu::item {
    padding: 8px 25px 8px 20px;
    border-radius: 3px;
    margin: 1px;
}

/* Hover en los items del menú desplegable */
QMenu::item:selected {
    background-color: #7aa2f7; /* Fondo azul brillante */
    color: #1a1b26;            /* Texto oscuro para contraste */
}

/* Separadores dentro del menú */
QMenu::separator {
    height: 1px;
    background-color: #414868;
    margin: 5px 10px;
}

/* Estilo para los atajos de teclado (Shortcuts) dentro del menú */
QMenu::item:disabled {
    color: #565f89;
}</string>
