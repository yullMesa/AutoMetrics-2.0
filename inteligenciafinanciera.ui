               <widget class="QSlider" name="verticalSlider_2">
                <property name="styleSheet">
                 <string notr="true">/* Contenedor del Slider Vertical */
QSlider::groove:vertical {
    border: 1px solid #414868;
    width: 6px;
    background: #1a1b26;
    margin: 0 2px;
    border-radius: 3px;
}

/* Parte recorrida (Abajo hacia el Handle) */
QSlider::sub-page:vertical {
    background: qlineargradient(x1:0, y1:1, x2:0, y2:0, 
                                stop:0 #7aa2f7, stop:1 #bb9af7);
    border: 1px solid #414868;
    width: 6px;
    border-radius: 3px;
}

/* Parte por recorrer (Arriba del Handle) */
QSlider::add-page:vertical {
    background: #24283b;
    border: 1px solid #414868;
    width: 6px;
    border-radius: 3px;
}

/* El botón circular (Handle) */
QSlider::handle:vertical {
    background: #c0caf5;
    border: 2px solid #7aa2f7;
    height: 16px;
    width: 16px;
    margin: 0 -6px; /* Centrado horizontal */
    border-radius: 8px;
}

QSlider::handle:vertical:hover {
    background: #ffffff;
    border: 2px solid #bb9af7;
}</string>
                </property>
