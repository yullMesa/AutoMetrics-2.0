                <property name="styleSheet">
                 <string notr="true">/* El botón del ComboBox cuando está cerrado */
QComboBox {
    background-color: #1a1b26;
    border: 1px solid #414868;
    border-radius: 4px;
    padding: 5px 10px;
    color: #a9b1d6;
    font-family: &quot;Segoe UI&quot;;
    font-size: 13px;
    min-width: 120px;
}

QComboBox:hover {
    border: 1px solid #7aa2f7; /* Brillo azul al pasar el mouse */
}

/* El botón de la flecha a la derecha */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border-left: 1px solid #414868;
}

/* Ícono de la flecha */
QComboBox::down-arrow {
    image: none; 
    border-top: 5px solid #7aa2f7; /* Triángulo azul */
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    margin-top: 2px;
}

/* La lista que aparece al hacer clic (El menú desplegable) */
QComboBox QAbstractItemView {
    background-color: #1a1b26;
    color: #a9b1d6;
    selection-background-color: #2f334d; /* Fondo de selección */
    selection-color: #9ece6a;            /* Texto verde al seleccionar */
    border: 1px solid #7aa2f7;
    outline: none;
    padding: 5px;
}

/* Estilo de los elementos individuales en la lista */
QComboBox QAbstractItemView::item {
    min-height: 30px;
    padding-left: 10px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #24283b;
    color: #ffffff;
}</string>
