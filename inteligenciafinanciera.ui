              <item>
               <widget class="QComboBox" name="comboBox_carro">
                <property name="styleSheet">
                 <string notr="true">/* El botón del ComboBox cuando está cerrado */
QComboBox {
    background-color: #1a1b26;
    border: 1px solid #414868;
    border-radius: 4px;
    padding: 5px 15px;
    color: #a9b1d6;
    font-size: 13px;
    min-width: 150px;
}

QComboBox:hover {
    border: 1px solid #7aa2f7; /* Brillo azul al pasar el mouse */
}

/* El botón de la flechita */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #414868;
}

/* El ícono de la flechita (puedes usar un caracter o imagen) */
QComboBox::down-arrow {
    image: none; /* Si quieres usar una imagen propia ponla aquí */
    border-top: 5px solid #7aa2f7; /* Flecha creada con bordes */
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    margin-top: 2px;
}

/* La lista que aparece al hacer clic */
QComboBox QAbstractItemView {
    background-color: #1a1b26;
    color: #a9b1d6;
    selection-background-color: #7aa2f7;
    selection-color: #1a1b26;
    border: 1px solid #414868;
    outline: none; /* Quita el recuadro de puntos al seleccionar */
}

/* Estilo de los items dentro de la lista */
QComboBox QAbstractItemView::item {
    min-height: 30px;
    padding-left: 10px;
}</string>
                </property>
