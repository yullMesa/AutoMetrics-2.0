}

/* Encabezados (Columnas) */
QHeaderView::section {
    background-color: #16161e;
    color: #7aa2f7; /* Azul neón para los títulos */
    padding: 6px;
    border: none;
    border-bottom: 2px solid #7aa2f7;
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;, sans-serif;
}

/* Estilo de las celdas al pasar el mouse */
QTableWidget::item:hover {
    background-color: #2f334d;
    color: #ffffff;
}

/* Scrollbars para el TableWidget */
QScrollBar:vertical {
    border: none;
    background: #1a1b26;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #414868;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #7aa2f7;
}</string>
