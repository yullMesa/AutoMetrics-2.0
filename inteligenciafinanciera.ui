}

QComboBox:hover {
    border: 1px solid #7aa2f7; /* Brillo azul al pasar el mouse */
}

/* El botón de la flecha */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #414868;
}

/* La flecha (dibujada con bordes) */
QComboBox::down-arrow {
    border-top: 5px solid #7aa2f7;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    margin-top: 2px;
}

/* La lista desplegable */
QComboBox QAbstractItemView {
    background-color: #1a1b26;
    color: #a9b1d6;
    selection-background-color: #7aa2f7; /* Color de selección azul */
    selection-color: #1a1b26;            /* Texto oscuro al seleccionar */
    border: 1px solid #7aa2f7;
    outline: none;
}</string>
