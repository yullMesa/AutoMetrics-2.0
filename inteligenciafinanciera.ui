                 <string notr="true">QTextEdit {
        background-color: #1a1b26;
        color: #a9b1d6;
        border: 2px solid #414868;
        border-radius: 12px;
        padding: 10px;
        font-family: 'Segoe UI', Arial;
        font-size: 14px;
        selection-background-color: #33467c;
    }
    
    /* Personalización de la barra de desplazamiento (Scrollbar) */
    QScrollBar:vertical {
        border: none;
        background: #16161e;
        width: 10px;
        margin: 0px;
        border-radius: 5px;
    }
    QScrollBar::handle:vertical {
        background: #414868;
        min-height: 20px;
        border-radius: 5px;
